# Copy to .env. Keep credentials server-side and never commit .env.
PORT=3001
CLIENT_PORT=5173
NODE_ENV=development

# Gemini request understanding and Desk Buddy help (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Amazon Creators API (Amazon.in Associates account with API access)
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_PARTNER_TAG=
# Optional overrides when Amazon supplies a different regional token/API endpoint.
AMAZON_CREATORS_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token
AMAZON_CREATORS_API_URL=https://creatorsapi.amazon/catalog/v1/searchItems

# Flipkart Affiliate API
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
FLIPKART_AFFILIATE_SEARCH_URL=https://affiliate-api.flipkart.net/affiliate/1.0/search.json

# Travel partner credentials are not used for consumer train search. The current
# public MakeMyTrip API is a corporate travel request handoff, not train inventory.
# MMT_PRIVATE_RAIL_SEARCH_URL=  # only if your licensed agreement provides this contract
# IRCTC_API_KEY=
# IRCTC_AGENT_ID=
# GOIBIBO_PARTNER_API_KEY=
